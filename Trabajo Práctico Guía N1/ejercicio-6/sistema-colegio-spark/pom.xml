<?xml version="1.0" encoding="UTF-8"?>
<!--
    ============================================================================
    POM.XML - Descriptor de proyecto Maven
    ============================================================================
    Proyecto: Sistema de Gestión Escolar (Colegio Spark)
    Arquitectura: MVC en capas (Model - View - Controller) sobre Spring Boot

    Este archivo declara:
      - El "parent" spring-boot-starter-parent, que gestiona automáticamente
        las versiones compatibles entre sí de todas las dependencias de Spring.
      - Los "starters" (paquetes de dependencias preconfiguradas) necesarios
        para cada capa de la aplicación:
          * spring-boot-starter-web          -> Capa Controller (MVC, Servlet, embebe Tomcat)
          * spring-boot-starter-thymeleaf    -> Capa View (motor de plantillas HTML)
          * spring-boot-starter-data-jpa     -> Capa Model/Repository (ORM - Hibernate)
          * mysql-connector-j                -> Driver JDBC para MySQL
          * spring-boot-starter-security     -> Autenticación y autorización (login docentes)
          * thymeleaf-extras-springsecurity6 -> Integra Spring Security con las vistas Thymeleaf
                                                 (permite usar sec:authorize en el HTML)
          * spring-boot-starter-validation   -> Validación de los DTO (Bean Validation / Jakarta)
          * spring-boot-starter-mail         -> Envío del correo de bienvenida al docente
          * lombok                           -> Genera getters/setters/constructores en tiempo
                                                 de compilación (reduce código repetitivo en
                                                 Entidades y DTO)
    ============================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot administra las versiones de todas las librerías compatibles -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.colegio</groupId>
    <artifactId>colegio-spark</artifactId>
    <version>1.0.0</version>
    <name>colegio-spark</name>
    <description>
        Sistema de Gestión Escolar - Registro de alumnos, grados, aulas, materias,
        docentes y notas. Trabajo práctico de arquitectura MVC con Thymeleaf, JPA/ORM,
        DTO, auditoría de entidades y seguridad (Spring Security).
    </description>

    <properties>
        <java.version>17</java.version>
        <!-- Versión concreta y fija de la librería que integra Spring Security con Thymeleaf -->
        <thymeleaf-extras-springsecurity6.version>3.1.2.RELEASE</thymeleaf-extras-springsecurity6.version>
    </properties>

    <dependencies>

        <!-- ========================= CAPA CONTROLLER (Web MVC) ========================= -->
        <!-- Provee @Controller, @RequestMapping, DispatcherServlet, Tomcat embebido, etc. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ========================= CAPA VIEW (Thymeleaf) ========================= -->
        <!-- Motor de plantillas server-side que renderiza los .html usando los atributos th:* -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- ========================= CAPA MODEL / PERSISTENCIA (ORM) ========================= -->
        <!-- Incluye Hibernate como implementación JPA, y Spring Data JPA (repositorios) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Driver JDBC oficial de MySQL, usado por Hibernate para dialogar con la base de datos -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ========================= SEGURIDAD ========================= -->
        <!-- Autenticación (login de docentes) y autorización (roles ADMIN / DOCENTE) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Permite usar en las vistas Thymeleaf el espacio de nombres sec: (ej: sec:authorize) -->
        <dependency>
            <groupId>org.thymeleaf.extras</groupId>
            <artifactId>thymeleaf-extras-springsecurity6</artifactId>
            <version>${thymeleaf-extras-springsecurity6.version}</version>
        </dependency>

        <!-- ========================= VALIDACIÓN DE DTO ========================= -->
        <!-- Habilita las anotaciones @NotBlank, @Email, @Past, @Size, @DecimalMin, etc. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ========================= ENVÍO DE CORREO (mail de bienvenida) ========================= -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- ========================= UTILITARIO: LOMBOK ========================= -->
        <!-- Genera en tiempo de compilación getters, setters, constructores y builders
             a partir de anotaciones (@Getter, @Setter, @NoArgsConstructor, etc.),
             evitando escribir manualmente ese código repetitivo en Entidades y DTO. -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ========================= HERRAMIENTAS DE DESARROLLO ========================= -->
        <!-- Reinicio automático del servidor ante cambios en el código (solo en desarrollo) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- ========================= TESTING ========================= -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <finalName>colegio-spark</finalName>
        <plugins>
            <!-- Empaqueta la aplicación como un JAR ejecutable (java -jar colegio-spark.jar) -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
