<?xml version="1.0" encoding="UTF-8"?>
<!--
    ============================================================================
    POM.XML - Descriptor de construcción Maven
    ============================================================================
    Este archivo define:
      1) Las coordenadas del proyecto (groupId/artifactId/version).
      2) El "parent" spring-boot-starter-parent, que fija versiones compatibles
         entre sí de todas las dependencias de Spring Boot (evita conflictos).
      3) Las dependencias necesarias para levantar una aplicación MVC completa:
           - spring-boot-starter-web        -> Controladores REST/MVC, Tomcat embebido
           - spring-boot-starter-thymeleaf  -> Motor de plantillas para la VISTA
           - spring-boot-starter-data-jpa   -> ORM (Hibernate) + Spring Data JPA
           - mysql-connector-j              -> Driver JDBC para MySQL
           - spring-boot-starter-validation -> Validaciones Bean Validation (@NotBlank, @Email, etc.)
           - spring-boot-devtools           -> Recarga en caliente durante el desarrollo
      4) El plugin de Spring Boot que empaqueta la app como un JAR ejecutable.
    ============================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Proyecto padre: fija el "Bill of Materials" (BOM) de versiones de Spring Boot -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.nexusai</groupId>
    <artifactId>nexusai-auth-mvc</artifactId>
    <version>1.0.0</version>
    <name>nexusai-auth-mvc</name>
    <description>
        Sistema de Registro / Autenticación con arquitectura MVC estricta,
        Spring MVC + Thymeleaf (VISTA), Spring Data JPA/Hibernate (ORM) y MySQL
        como motor de base de datos. Trabajo práctico académico.
    </description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!-- ================= CAPA WEB / CONTROLLER (MVC) ================= -->
        <!-- Provee @Controller, @RequestMapping, DispatcherServlet, Tomcat embebido -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ================= CAPA VISTA (VIEW) ================= -->
        <!-- Integra el motor de plantillas Thymeleaf con Spring MVC -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- ================= CAPA MODELO / PERSISTENCIA (ORM) ================= -->
        <!-- Spring Data JPA (encima de Hibernate) para mapear clases Java <-> tablas SQL -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Driver JDBC que permite a Hibernate/JPA conectarse físicamente a MySQL -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Validaciones declarativas sobre los DTOs (Bean Validation / Jakarta Validation) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            Se incluye ÚNICAMENTE el módulo "crypto" de Spring Security (no el
            starter completo) para poder usar BCryptPasswordEncoder al hashear
            las contraseñas. A propósito NO se agrega spring-boot-starter-security
            porque el enunciado pide una autenticación propia y simple (usuario +
            clave + bloqueo a los 3 intentos), controlada íntegramente por
            nuestra capa Service/Controller, sin la cadena de filtros y el
            login automático que activaría el starter completo de Security.
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- Utilidad para recarga automática en desarrollo (no se incluye en el JAR final) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- ================= TESTING ================= -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>nexusai-auth-mvc</finalName>
        <plugins>
            <!-- Empaqueta la app como JAR ejecutable con servidor embebido (java -jar ...) -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
