<?xml version="1.0" encoding="UTF-8"?>
<!--
    ============================================================================
    pom.xml - Archivo de configuración de Maven (Project Object Model)
    ============================================================================
    Define las dependencias, el plugin de compilación y los metadatos del
    proyecto "tienda-tech": un sistema de ventas de tecnología basado en
    Spring Boot + Hibernate (JPA) + MySQL, siguiendo el patrón MVC.
    ============================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        spring-boot-starter-parent: proporciona la gestión centralizada de
        versiones (dependency management) para todas las dependencias de
        Spring Boot, además de configuración por defecto del compilador,
        del plugin de empaquetado, etc. Evita tener que fijar versiones
        manualmente en cada starter.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/> <!-- busca el parent en el repositorio remoto, no en el sistema de archivos -->
    </parent>

    <groupId>com.tienda</groupId>
    <artifactId>tienda-tecnologia</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>tienda-tecnologia</name>
    <description>Sistema de ventas de tecnologia - Capa de persistencia (JPA/Hibernate + MySQL)</description>

    <properties>
        <!-- Versión de Java utilizada por el proyecto (LTS) -->
        <java.version>21</java.version>
        <!-- Versión de MapStruct, se referencia en varias dependencias más abajo -->
        <mapstruct.version>1.5.5.Final</mapstruct.version>
        <!-- Versión del "binding" que ordena la ejecución de Lombok antes que MapStruct -->
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
    </properties>

    <dependencies>

        <!--
            spring-boot-starter-data-jpa:
            Incluye Hibernate (implementación de JPA), Spring Data JPA
            (repositorios CRUD automáticos) y el pool de conexiones HikariCP.
            Es el corazón de la capa de persistencia ORM.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!--
            spring-boot-starter-web:
            Habilita la creación de controladores REST/MVC, incluye Tomcat
            embebido y Jackson para serialización JSON. Necesario para la
            capa de Controlador dentro del patrón MVC.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            spring-boot-starter-thymeleaf:
            Motor de plantillas server-side para renderizar las vistas HTML
            (capa "View" del patrón MVC), integrado de forma nativa con
            Spring MVC.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!--
            spring-boot-starter-validation:
            Aporta Hibernate Validator, la implementación de referencia de
            Jakarta Bean Validation. Es la dependencia que hace que
            anotaciones como @NotBlank, @NotNull, @Positive, @Size, etc.
            (usadas en los DTOs) sean efectivamente evaluadas. Desde
            Spring Boot 2.3, spring-boot-starter-web YA NO la incluye por
            defecto, por lo que debe declararse explícitamente.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            spring-boot-starter-security:
            Provee el framework de autenticación y autorización de Spring.
            Se utilizará junto a las entidades Usuario/Rol para proteger
            los endpoints y gestionar el login (contraseñas con BCrypt).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!--
            mysql-connector-j:
            Driver JDBC oficial de MySQL. Permite que Hibernate/JPA se
            comunique con el motor de base de datos MySQL.
            "runtime" porque solo se necesita en tiempo de ejecución,
            no para compilar el código.
        -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            Lombok:
            Genera en tiempo de compilación (vía anotaciones como @Getter,
            @Setter, @NoArgsConstructor, @Builder, etc.) el código repetitivo
            (boilerplate) de las entidades, evitando escribirlo a mano.
            "optional=true" porque es una herramienta de desarrollo, no una
            dependencia que deba propagarse a otros proyectos que usen este.
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            MapStruct:
            Generador de código para el mapeo automático entre Entidades
            (JPA) y DTOs (Data Transfer Objects), evitando escribir esos
            mappers manualmente. Se usará más adelante en la capa de
            servicio/DTOs.
        -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>

        <!--
            spring-boot-starter-test:
            Incluye JUnit 5, Mockito y otras librerías necesarias para
            pruebas unitarias e integración. Solo se usa en la fase de test.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            spring-security-test:
            Utilidades para probar configuraciones de seguridad
            (por ejemplo, simular usuarios autenticados en tests).
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!--
                spring-boot-maven-plugin:
                Permite ejecutar la aplicación con "mvn spring-boot:run" y
                empaquetarla como un JAR ejecutable ("fat jar") con todas
                sus dependencias incluidas.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!--
                        Excluye Lombok del jar final: Lombok solo actúa en
                        tiempo de compilación, no es necesario en runtime.
                    -->
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!--
                maven-compiler-plugin:
                Se configura explícitamente para declarar, en orden, los
                "annotation processors" que deben ejecutarse durante la
                compilación:
                  1) lombok               -> genera getters/setters/etc.
                  2) lombok-mapstruct-binding -> asegura que Lombok se
                     ejecute ANTES que MapStruct, para que los mappers
                     generados puedan ver los getters/setters ya creados.
                  3) mapstruct-processor  -> genera las implementaciones
                     de las interfaces @Mapper.
                Sin esta configuración explícita, Lombok y MapStruct pueden
                entrar en conflicto porque ambos son procesadores de
                anotaciones que actúan en la misma fase de compilación.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>${lombok-mapstruct-binding.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>